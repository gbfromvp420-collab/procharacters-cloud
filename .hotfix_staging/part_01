  const handleAccountSessionResume = async (sessionIdToResume: string) => {
    if (!account) return;
    clearSessionState();
    try {
      setStatus("connecting");
      const session = await resumeAccountSession(account.token, sessionIdToResume);
      await openLiveSession(session);
