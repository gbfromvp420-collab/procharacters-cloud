    const name =
      characters.find((c) => c.id === character)?.displayName ?? characterName ?? character;
    const result = await shareOrCopyUrl({
      url,
      title: `${name} · Procharacters`,
      text: autostart
        ? `Chat with ${name} on Procharacters.cloud`
        : `Meet ${name} on Procharacters.cloud`,
    });
