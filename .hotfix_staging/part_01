      setCustomAppearance("");
      setCustomEnergy("");
      setCustomClothing("");
      setCustomPhrase1("");
      setCustomPhrase2("");
      setCustomPhrase3("");
      setCustomScene1Title("");
      setCustomScene1Body("");
      setCustomScene2Title("");
      setCustomScene2Body("");
      setCustomScene3Title("");
      setCustomScene3Body("");
      setMediaBase("");
      setClipIdle("");
      setClipTeasing("");
