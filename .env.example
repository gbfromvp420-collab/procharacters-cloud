# =============================================================================
# procharacters WebRTC + trainer studio — environment template
# Copy to `.env` and fill in secrets before `docker compose up`.
# =============================================================================

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Provider selection -----------------------------------------------------
# Video generation backend: mock | runpod
VIDEO_PROVIDER=mock
# LLM backend: mock | runpod  (defaults to VIDEO_PROVIDER when unset)
LLM_PROVIDER=mock

# --- RunPod inference (MuseTalk talking-head + character LLM) ---------------
# Base URLs for serverless / pod endpoints (include /v2/<endpoint-id> path)
RUNPOD_MUSETALK_URL=
RUNPOD_LLM_URL=
# Shared API key → Authorization: Bearer …
RUNPOD_API_KEY=

# HTTP client behaviour
RUNPOD_TIMEOUT_SECONDS=30
RUNPOD_CONNECT_TIMEOUT_SECONDS=5
# On network/timeout failures, fall back to in-process mock providers
RUNPOD_FALLBACK_TO_MOCK=true

# --- Training / fine-tune (Kohya_ss, Unsloth, XTTS) -------------------------
# Remote training worker URL (async /run preferred for long jobs)
RUNPOD_TRAINING_URL=
# Optional dedicated key; falls back to RUNPOD_API_KEY when empty
RUNPOD_TRAINING_API_KEY=

# Object-storage bucket (or s3://bucket[/prefix]) for trained weights + datasets
# Used by the weight registry and RunPod job payloads
WEIGHTS_STORAGE_BUCKET=

# --- Notes ------------------------------------------------------------------
# • Leave RUNPOD_* empty and VIDEO_PROVIDER/LLM_PROVIDER=mock for local smoke.
# • Frontend hot-swap reads GET /api/v1/trainer/weights (registry on disk + bucket).
# • Never commit a real .env with secrets.
