# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Production — public API URL used for wss:// links in session create
# PUBLIC_API_URL=https://your-backend.up.railway.app

# Repo root (auto-detected if omitted)
# REPO_ROOT=C:\Users\gbvp6\Documents\procharacters-cloud

# Session defaults
DEFAULT_CHARACTER_ID=twink-default
SESSION_TTL_MINUTES=120
MAX_MESSAGE_WINDOW=30

# Grok / xAI — required for real in-character replies
# Get your key: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_COMPLETION_TOKENS=1024
XAI_TEMPERATURE=0.85

# LiveKit — optional; enables room metadata sync for multi-client video state
# https://cloud.livekit.io/
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Media Generation Provider
# Options: placeholder (default), generic, internal, flux, sdxl
# NOTE: RunwayML was removed — it does not allow NSFW content.
# "generic" works with any self-hosted NSFW endpoint (ComfyUI, A1111, Fooocus, etc.)
MEDIA_PROVIDER=placeholder
# MEDIA_API_KEY=your_media_api_key_here
# MEDIA_BASE_URL=http://localhost:7860/api
# MEDIA_MODEL_ID=realisticVisionV60
MEDIA_CONCURRENCY=2
MEDIA_WIDTH=512
MEDIA_HEIGHT=768
MEDIA_VIDEO_DURATION=6
# MEDIA_SAMPLER=euler_a
# MEDIA_STEPS=30
# MEDIA_CFG_SCALE=7

# ElevenLabs Voice Generation
# https://elevenlabs.io/ — gives characters a voice during live sessions
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_DEFAULT_VOICE_ID=your_voice_id_here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Redis / Postgres (v2.1+)
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=******localhost:5432/procharacters

# Authentication (JWT)
# JWT_SECRET=your-secure-random-secret-here-min-32-chars

# Rate Limiting & Security
# CORS_ORIGIN=https://procharacters.cloud,https://app.procharacters.cloud
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000