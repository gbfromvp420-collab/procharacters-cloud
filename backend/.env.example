# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Production — public API URL used for wss:// links in session create
# PUBLIC_API_URL=https://your-backend.up.railway.app

# Runtime custom characters JSON (defaults to <repo>/data/custom-characters.json)
# On Railway, mount a volume at /data and keep:
# CUSTOM_CHARACTERS_PATH=/data/custom-characters.json
# SESSIONS_PATH=/data/sessions

# Repo root (auto-detected if omitted)
# REPO_ROOT=C:\Users\gbvp6\Documents\procharacters-cloud

# Session defaults
DEFAULT_CHARACTER_ID=twink-default
SESSION_TTL_MINUTES=120
MAX_MESSAGE_WINDOW=30

# Grok / xAI — required for real in-character replies
# Get your key: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_COMPLETION_TOKENS=1024
XAI_TEMPERATURE=0.85

# LiveKit — optional; enables room metadata sync for multi-client video state
# https://cloud.livekit.io/
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Redis / Postgres (v2.1+)
# REDIS_URL=
# DATABASE_URL=