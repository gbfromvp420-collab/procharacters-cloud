# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Production — public API URL used for wss:// links in session create
# PUBLIC_API_URL=https://your-backend.up.railway.app

# Runtime custom characters JSON (defaults to <repo>/data/custom-characters.json)
# On Railway, mount a volume at /data and keep:
# CUSTOM_CHARACTERS_PATH=/data/custom-characters.json
# SESSIONS_PATH=/data/sessions
# ACCOUNTS_PATH=/data/accounts.json
# UPLOADS_PATH=/data/uploads
# MAX_UPLOAD_BYTES=41943040
# Magic-link email (optional — without RESEND_API_KEY the API returns the link)
# RESEND_API_KEY=
# MAGIC_LINK_FROM=Procharacters <login@yourdomain.com>
# MAGIC_LINK_BASE_URL=https://procharacters-web-production-7288.up.railway.app
#
# Rate limits (optional overrides)
# RATE_LIMIT_MAGIC_IP=8
# RATE_LIMIT_MAGIC_EMAIL=4
# RATE_LIMIT_AUTH_IP=30
# RATE_LIMIT_UPLOAD_IP=40
# RATE_LIMIT_UPLOAD_CHAR=20

# Repo root (auto-detected if omitted)
# REPO_ROOT=C:\Users\gbvp6\Documents\procharacters-cloud

# Session defaults
DEFAULT_CHARACTER_ID=twink-default
SESSION_TTL_MINUTES=120
MAX_MESSAGE_WINDOW=30

# Grok / xAI — required for real in-character replies
# Get your key: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_COMPLETION_TOKENS=1024
XAI_TEMPERATURE=0.85

# Opt-in generative video (Python side service on :8000). Unset = 4-loop clips only.
# docker compose --profile webrtc up webrtc
# GEN_VIDEO_SERVICE_URL=http://127.0.0.1:8000

# LiveKit — optional; enables room metadata sync for multi-client video state
# https://cloud.livekit.io/
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Redis / Postgres (v2.1+)
# REDIS_URL=
# DATABASE_URL=postgresql://user:pass@host:5432/procharacters
#
# Auth backend: json (default) = /data/accounts.json · prisma = full Postgres dual-write
# (handle/passphrase, magic links, resume codes, plan grants). Needs DATABASE_URL + migrations.
# ACCOUNTS_PROVIDER=json
# Web Push (VAPID) � optional resume-code expiry alerts via service worker
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@procharacters.cloud
# PUSH_SUBSCRIPTIONS_PATH=/data/push-subscriptions.json
# RESUME_EXPIRY_PUSH_DAYS=3
# RESUME_EXPIRY_PUSH_COOLDOWN_MS=43200000

# RESUME_EXPIRY_PUSH_CRON_MS=3600000
# Set 0 to disable background expiry push scan

