# Copy to backend/.env for local development

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Optional in local dev. Set this in deployed environments so session payloads
# can return the public HTTPS/WSS host instead of localhost.
# PUBLIC_API_URL=https://your-backend.up.railway.app

# Optional repo root override (auto-detected if omitted)
# REPO_ROOT=/absolute/path/to/procharacters-cloud

# Session defaults
DEFAULT_CHARACTER_ID=twink-default
SESSION_TTL_MINUTES=120
MAX_MESSAGE_WINDOW=30

# Grok / xAI — required for real in-character replies
# Get your key: https://console.x.ai/
# Keep this value only in your local untracked .env or your deployment secret manager.
# If the key is ever pasted into chat, logs, or a tracked file, revoke and rotate it immediately.
XAI_API_KEY=
XAI_MODEL=grok-3
XAI_BASE_URL=https://api.x.ai/v1
XAI_MAX_COMPLETION_TOKENS=1024
XAI_TEMPERATURE=0.85

# LiveKit — optional; enables room metadata sync for multi-client video state
# https://cloud.livekit.io/
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=