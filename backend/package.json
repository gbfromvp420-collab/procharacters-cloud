{
  "name": "@procharacters/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Procharacters.cloud v2 live session API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "prisma:link": "bash ../scripts/ensure-prisma-link.sh",
    "prisma:generate": "npm run prisma:link && prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "npm run prisma:link && prisma migrate deploy --schema=../prisma/schema.prisma",
    "smoke:local": "bash ../scripts/smoke-local-product.sh --skip-install",
    "accounts:import-json": "tsx scripts/import-accounts-json.ts",
    "accounts:smoke-prisma": "tsx scripts/smoke-accounts-prisma.ts",
    "test:memory": "tsx scripts/smoke-test-memory.ts",
    "test:livekit": "tsx scripts/verify-livekit.ts",
    "smoke:deploy": "tsx scripts/smoke-deploy.ts",
    "avatar:check-packs": "tsx scripts/check-avatar-packs.ts",
    "generate:avatar-loops": "tsx scripts/generate-avatar-loops.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "@fastify/websocket": "^11.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "livekit-server-sdk": "^2.13.0",
    "pg": "^8.22.0",
    "stripe": "^22.3.1",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.3.3",
    "prisma": "^7.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "ws": "^8.18.2"
  }
}
